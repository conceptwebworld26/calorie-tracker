# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real keys.

# Required for the AI nutrition lookup routes (/api/analyze/text and
# /api/analyze/image). Get a key at https://aistudio.google.com/apikey
# The rest of the app runs without it.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional. Overrides the Gemini model used for nutrition estimation.
# Defaults to gemini-3.5-flash-lite when unset.
GEMINI_MODEL=gemini-3.5-flash-lite
